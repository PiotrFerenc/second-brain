<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SecondBrain.Desktop.ViewModels"
        xmlns:conv="using:SecondBrain.Desktop.Converters"
        xmlns:acnv="using:Avalonia.Data.Converters"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="SecondBrain.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="700"
        Icon="/Assets/avalonia-logo.ico"
        Title="Second Brain">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding ShowEditorTabCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding ShowSearchTabCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveNoteCommand}" />
    </Window.KeyBindings>

    <Grid ColumnDefinitions="270,*">

        <!-- Boczny panel: drzewo folderow (kolorowe kropki jak sekcje OneNote) i notatek -->
        <DockPanel Grid.Column="0" Margin="24,28,16,24">

            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Second Brain" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Twoja baza wiedzy" Classes="subtle" FontSize="12.5" />
            </StackPanel>

            <!-- Pasek narzedzi: akcje globalne, niezalezne od wybranego folderu -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
                <Button Content="Szukaj" Classes="subtleAction" Command="{Binding ShowSearchTabCommand}" />
                <Button Content="Kosz" Classes="subtleAction" Command="{Binding ShowTrashTabCommand}" />
                <Button Content="{Binding Gaps.Count, StringFormat='Luki ({0})'}"
                        Classes="subtleAction" Command="{Binding ShowGapsTabCommand}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,20,0,0">
                <TextBox Text="{Binding NewFolderName}" PlaceholderText="nazwa nowego folderu" />
                <Button Content="Nowy folder"
                        Classes="accent"
                        Command="{Binding CreateFolderCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <Button Content="Usuń folder"
                        Classes="danger"
                        Command="{Binding DeleteFolderCommand}"
                        IsVisible="{Binding !ConfirmDeleteFolder}"
                        IsEnabled="{Binding SelectedFolder, Converter={x:Static acnv:ObjectConverters.IsNotNull}}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,8,0,0" />
                <Button Content="Na pewno? Kliknij ponownie"
                        Classes="danger"
                        Command="{Binding DeleteFolderCommand}"
                        IsVisible="{Binding ConfirmDeleteFolder}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,8,0,0" />
            </StackPanel>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="FOLDERY" Classes="label" Margin="10,0,0,8" />

                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding ActiveTagFilter, Converter={x:Static acnv:ObjectConverters.IsNotNull}}"
                        Background="{DynamicResource CtpSurface0}"
                        CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="subtle" FontSize="12" TextWrapping="Wrap">
                            <Run Text="tag: " /><Run Text="{Binding ActiveTagFilter}" />
                        </TextBlock>
                        <Button Grid.Column="1" Content="×" Classes="subtleAction" Padding="6,0" Command="{Binding ClearTagFilterCommand}" />
                    </Grid>
                </Border>

                <Panel>
                    <TextBlock Text="Brak folderów. Utwórz pierwszy poniżej."
                               Classes="subtle" TextWrapping="Wrap"
                               Margin="10,4,10,0"
                               IsVisible="{Binding !HasFolders}" />

                    <TreeView ItemsSource="{Binding Tree}"
                              SelectedItem="{Binding SelectedTreeItem}"
                              IsVisible="{Binding HasFolders}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeItem">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="8" Height="8"
                                             IsVisible="{Binding IsFolder}"
                                             Fill="{Binding OwningFolder, Converter={x:Static conv:FolderAccentConverter.Instance}}" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Panel>
            </DockPanel>

        </DockPanel>

        <!-- "Kartka" z treścią - jaśniejsza plaszczyzna nad ciemniejszym chrome, jak strona w OneNote -->
        <Border Grid.Column="1"
                Background="{DynamicResource CtpBase}"
                CornerRadius="16,0,0,0"
                Margin="0,12,0,0"
                BoxShadow="0 0 24 0 #22000000">

            <DockPanel Margin="28,20,28,24">

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <!-- Tylko te dwie maja naglowek w prawym panelu - Szukaj i Kosz sa
                         dostepne wylacznie z paska narzedzi w sidebarze. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24"
                                IsVisible="{Binding IsContentHeaderVisible}">
                        <Button Content="Notatka"
                                Classes="tabHeader"
                                Classes.active="{Binding IsNoteTabActive}"
                                Command="{Binding ShowNoteTabCommand}" />
                        <Button Content="+"
                                Classes="tabHeader"
                                Classes.active="{Binding IsEditorTabActive}"
                                FontSize="24"
                                Command="{Binding ShowEditorTabCommand}"
                                ToolTip.Tip="Nowa notatka" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource CtpSurface0}"
                            CornerRadius="6" Padding="10,4"
                            VerticalAlignment="Top"
                            IsVisible="{Binding SelectedFolder, Converter={x:Static acnv:ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding SelectedFolder}" Classes="subtle" FontSize="12.5" />
                    </Border>
                </Grid>

                <Panel>

                <DockPanel Margin="0,20,0,0" IsVisible="{Binding IsEditorTabActive}">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                            <Button Content="Zapisz"
                                    Classes="accent"
                                    Command="{Binding SaveNoteCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <TextBlock Text="{Binding EditorStatus}"
                                       Classes="subtle"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" x:Name="TemplatesPanel" Orientation="Horizontal" Spacing="8" />
                                <Button Grid.Column="1" Content="Importuj z pliku..." Classes="subtleAction" Click="ImportFile_Click" />
                            </Grid>
                            <TextBox Text="{Binding NoteTagsInput}" PlaceholderText="tagi po przecinku (puste = LLM zaproponuje)" />
                            <ComboBox ItemsSource="{Binding ParentOptions}"
                                      SelectedItem="{Binding SelectedParentOption}"
                                      PlaceholderText="Notatka nadrzędna (opcjonalnie)"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SearchResultItem">
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto,*">
                            <TextBox Grid.Column="0"
                                     Text="{Binding NoteText}"
                                     Classes="editor"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     PlaceholderText="Wpisz notatkę... (odwołaj się do innej przez [[Tytuł notatki]])"
                                     FontSize="15" />

                            <Border Grid.Column="1" Width="1" Background="{DynamicResource CtpSurface2}" Margin="16,0" />

                            <md:MarkdownScrollViewer Grid.Column="2" Markdown="{Binding NoteText}" />
                        </Grid>
                    </DockPanel>

                    <DockPanel Margin="0,20,0,0" IsVisible="{Binding IsSearchTabActive}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                            <TextBox Text="{Binding SearchQuery}" PlaceholderText="Zadaj pytanie..." Width="420" />
                            <Button Content="Szukaj"
                                    Classes="accent"
                                    Command="{Binding SearchCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <CheckBox Content="{Binding SelectedFolder, StringFormat='tylko w folderze: {0}'}"
                                      IsChecked="{Binding SearchCurrentFolderOnly}"
                                      IsEnabled="{Binding SelectedFolder, Converter={x:Static acnv:ObjectConverters.IsNotNull}}"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <Border DockPanel.Dock="Top"
                                IsVisible="{Binding HasAnswer}"
                                Background="{DynamicResource CtpSurface0}"
                                CornerRadius="10"
                                Padding="16,14"
                                Margin="0,0,0,16">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="ODPOWIEDŹ" Classes="label" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Kopiuj" Classes="subtleAction" Click="CopyAnswer_Click" />
                                </Grid>
                                <TextBlock Text="{Binding SynthesizedAnswer}"
                                           TextWrapping="Wrap" FontSize="14.5" LineHeight="21" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="280,*">

                            <Panel Grid.Column="0">
                                <StackPanel Spacing="4" IsVisible="{Binding !HasResults}">
                                    <TextBlock Text="Wpisz pytanie i kliknij Szukaj."
                                               Classes="subtle" TextWrapping="Wrap"
                                               IsVisible="{Binding !HasSearched}" />
                                    <TextBlock Text="Brak wyników dla tego zapytania."
                                               Classes="subtle" TextWrapping="Wrap"
                                               IsVisible="{Binding HasSearched}" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding SearchResults}"
                                         SelectedItem="{Binding SelectedResult}"
                                         IsVisible="{Binding HasResults}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SearchResultItem">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                                <TextBlock Classes="subtle" FontSize="11.5">
                                                    <Run Text="{Binding Folder}" /><Run Text=" · trafność " /><Run Text="{Binding Score, StringFormat='{}{0:0.00}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>

                            <DockPanel Grid.Column="1" Margin="20,0,0,0"
                                       IsVisible="{Binding SelectedResult, Converter={x:Static acnv:ObjectConverters.IsNotNull}}">
                                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                    <Button Grid.Column="1" Content="Kopiuj" Classes="subtleAction" Click="CopySearchResult_Click" />
                                    <Button Grid.Column="2" Content="Usuń"
                                            Classes="subtleAction"
                                            Command="{Binding DeleteNoteCommand}"
                                            CommandParameter="{Binding SelectedResult}" />
                                </Grid>
                                <md:MarkdownScrollViewer Markdown="{Binding SelectedResult.RawContent}" />
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                    <DockPanel Margin="0,20,0,0" IsVisible="{Binding IsNoteTabActive}">
                    <DockPanel IsVisible="{Binding SelectedNote, Converter={x:Static acnv:ObjectConverters.IsNotNull}}">
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedNote.Title}"
                                           FontSize="19" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="{Binding SelectedNote.Pinned, Converter={x:Static conv:PinLabelConverter.Instance}}"
                                        Classes="subtleAction" Command="{Binding TogglePinCommand}" />
                                <Button Grid.Column="2" Content="Kopiuj" Classes="subtleAction" Click="CopyNote_Click" />
                                <Button Grid.Column="3" Content="Usuń" Classes="subtleAction"
                                        Command="{Binding DeleteNoteCommand}" CommandParameter="{Binding SelectedNote}" />
                            </Grid>
                            <WrapPanel x:Name="NoteTagsPanel" />
                            <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap">
                                <Run Text="Odnośniki do tej notatki: " /><Run Text="{Binding BacklinksText}" />
                            </TextBlock>
                        </StackPanel>

                        <md:MarkdownScrollViewer Markdown="{Binding SelectedNote.RawContent}" />
                    </DockPanel>
                    </DockPanel>

                    <DockPanel Margin="0,20,0,0" IsVisible="{Binding IsTrashTabActive}">
                        <Grid ColumnDefinitions="280,*">

                            <Panel Grid.Column="0">
                                <TextBlock Text="Kosz jest pusty."
                                           Classes="subtle" TextWrapping="Wrap"
                                           IsVisible="{Binding !HasTrash}" />

                                <ListBox ItemsSource="{Binding TrashItems}"
                                         SelectedItem="{Binding SelectedTrashItem}"
                                         IsVisible="{Binding HasTrash}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TrashItem">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding OriginalFolder}" Classes="subtle" FontSize="11.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>

                            <DockPanel Grid.Column="1" Margin="20,0,0,0"
                                       IsVisible="{Binding SelectedTrashItem, Converter={x:Static acnv:ObjectConverters.IsNotNull}}">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                    <Button Content="Przywróć" Classes="accent"
                                            Command="{Binding RestoreFromTrashCommand}"
                                            CommandParameter="{Binding SelectedTrashItem}" />
                                    <Button Content="Usuń na zawsze" Classes="danger"
                                            Command="{Binding PurgeFromTrashCommand}"
                                            CommandParameter="{Binding SelectedTrashItem}" />
                                </StackPanel>
                                <md:MarkdownScrollViewer Markdown="{Binding SelectedTrashItem.RawContent}" />
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                    <DockPanel Margin="0,20,0,0" IsVisible="{Binding IsGapsTabActive}">
                        <Grid ColumnDefinitions="280,*">

                            <Panel Grid.Column="0">
                                <TextBlock Text="Brak luk w wiedzy - na wszystko masz odpowiedź w notatkach."
                                           Classes="subtle" TextWrapping="Wrap"
                                           IsVisible="{Binding !HasGaps}" />

                                <ListBox ItemsSource="{Binding Gaps}"
                                         SelectedItem="{Binding SelectedGap}"
                                         IsVisible="{Binding HasGaps}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GapItem">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Query}" FontWeight="Medium" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding AskedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                           Classes="subtle" FontSize="11.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>

                            <DockPanel Grid.Column="1" Margin="20,0,0,0"
                                       IsVisible="{Binding SelectedGap, Converter={x:Static acnv:ObjectConverters.IsNotNull}}">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                    <Button Content="Szukaj ponownie" Classes="accent"
                                            Command="{Binding RetryGapSearchCommand}"
                                            CommandParameter="{Binding SelectedGap}" />
                                    <Button Content="Odrzuć" Classes="danger"
                                            Command="{Binding ResolveGapCommand}"
                                            CommandParameter="{Binding SelectedGap}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedGap.Query}" TextWrapping="Wrap" FontSize="15" LineHeight="22" />
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                </Panel>
            </DockPanel>
        </Border>

    </Grid>

</Window>
