<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SecondBrain.Desktop.ViewModels"
        xmlns:conv="using:SecondBrain.Plugins.Sdk.Converters"
        xmlns:sdk="using:SecondBrain.Plugins.Sdk"
        xmlns:acnv="using:Avalonia.Data.Converters"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="SecondBrain.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="700"
        Icon="/Assets/avalonia-logo.ico"
        Title="Second Brain">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding ShowEditorTabCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveNoteCommand}" />
    </Window.KeyBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="270" MinWidth="200" MaxWidth="500" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pionowy pasek po lewej: Agent (rdzen) + zakladki pluginow (ITabContribution, Placement=SidebarToolbar),
             pluginy posortowane alfabetycznie po tytule w MainWindow.RegisterPluginTabs. -->
        <Border Grid.Column="0" Padding="10,28,10,24" Background="{DynamicResource CtpMantle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <Button Content="Agent" Classes="subtleAction" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Command="{Binding ShowAgentTabCommand}" />
                    <ItemsControl ItemsSource="{Binding ToolbarTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sdk:ITabContribution">
                                <Button Content="{Binding Title}" Classes="subtleAction" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowPluginTabCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Boczny panel: drzewo folderow (kolorowe kropki jak sekcje OneNote) i notatek -->
        <DockPanel Grid.Column="1" Margin="16,28,16,24">

            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Second Brain" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Twoja baza wiedzy" Classes="subtle" FontSize="12.5" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,20,0,0">
                <TextBox Text="{Binding NewFolderName}" PlaceholderText="nazwa nowego folderu" />
                <Button Content="Nowy folder"
                        Classes="accent"
                        Command="{Binding CreateFolderCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <Button Content="Usuń folder"
                        Classes="danger"
                        Command="{Binding DeleteFolderCommand}"
                        IsVisible="{Binding !ConfirmDeleteFolder}"
                        IsEnabled="{Binding SelectedFolder, Converter={x:Static acnv:ObjectConverters.IsNotNull}}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,8,0,0" />
                <Button Content="Na pewno? Kliknij ponownie"
                        Classes="danger"
                        Command="{Binding DeleteFolderCommand}"
                        IsVisible="{Binding ConfirmDeleteFolder}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,8,0,0" />
            </StackPanel>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="FOLDERY" Classes="label" Margin="10,0,0,8" />

                <sdk:SlotHost DockPanel.Dock="Top" SlotId="Sidebar.AboveTree" Orientation="Vertical" />

                <Panel>
                    <TextBlock Text="Brak folderów. Utwórz pierwszy poniżej."
                               Classes="subtle" TextWrapping="Wrap"
                               Margin="10,4,10,0"
                               IsVisible="{Binding !HasFolders}" />

                    <TreeView ItemsSource="{Binding Tree}"
                              SelectedItem="{Binding SelectedTreeItem}"
                              IsVisible="{Binding HasFolders}">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:TreeItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeItem">
                                <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent"
                                            PointerPressed="TreeItem_PointerPressed" PointerMoved="TreeItem_PointerMoved"
                                            DragDrop.AllowDrop="True" DragDrop.DragOver="TreeItem_DragOver" DragDrop.Drop="TreeItem_Drop">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Dodaj notatkę"
                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddNoteHereCommand}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <Ellipse Width="8" Height="8"
                                             IsVisible="{Binding IsFolder}"
                                             Fill="{Binding OwningFolder, Converter={x:Static conv:FolderAccentConverter.Instance}}" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Panel>
            </DockPanel>

        </DockPanel>

        <!-- Uchwyt do reczengo rozciagania sidebaru - dlugie tytuly notatek nie miescily sie
             w stalych 270px. Dyskretny w spoczynku, widoczny na hover/podczas przeciagania. -->
        <GridSplitter Grid.Column="2"
                      Width="5"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      Cursor="SizeWestEast" />

        <!-- "Kartka" z treścią - jaśniejsza plaszczyzna nad ciemniejszym chrome, jak strona w OneNote -->
        <Border Grid.Column="3"
                Background="{DynamicResource CtpBase}"
                CornerRadius="16,0,0,0"
                Margin="0,12,0,0"
                BoxShadow="0 0 24 0 #22000000">

            <DockPanel Margin="28,20,28,24">

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <!-- Tylko te dwie maja naglowek w prawym panelu - Szukaj i Kosz sa
                         dostepne wylacznie z paska narzedzi w sidebarze. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24"
                                IsVisible="{Binding IsContentHeaderVisible}">
                        <Button Content="Notatka"
                                Classes="tabHeader"
                                Classes.active="{Binding IsNoteTabActive}"
                                Command="{Binding ShowNoteTabCommand}" />
                        <Button Content="+"
                                Classes="tabHeader"
                                Classes.active="{Binding IsEditorTabActive}"
                                FontSize="24"
                                Command="{Binding ShowEditorTabCommand}"
                                ToolTip.Tip="Nowa notatka" />
                        <ItemsControl ItemsSource="{Binding HeaderTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="24" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sdk:ITabContribution">
                                    <Button Content="{Binding Title}" Classes="tabHeader"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowPluginTabCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource CtpSurface0}"
                            CornerRadius="6" Padding="10,4"
                            VerticalAlignment="Top"
                            IsVisible="{Binding SelectedFolder, Converter={x:Static acnv:ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding SelectedFolder}" Classes="subtle" FontSize="12.5" />
                    </Border>
                </Grid>

                <Panel>

                <ContentControl Content="{Binding ActiveTabView}" IsVisible="{Binding IsPluginTabActive}" Margin="0,20,0,0" />

                <DockPanel Margin="0,20,0,0" IsVisible="{Binding IsEditorTabActive}">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                            <Button Content="Zapisz"
                                    Classes="accent"
                                    Command="{Binding SaveNoteCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <TextBlock Text="{Binding EditorStatus}"
                                       Classes="subtle"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <sdk:SlotHost Grid.Column="0" SlotId="Editor.Templates" />
                                <sdk:SlotHost Grid.Column="1" SlotId="Editor.Toolbar" Margin="8,0,0,0" />
                            </Grid>
                            <TextBox Text="{Binding NoteTagsInput}" PlaceholderText="tagi po przecinku (puste = LLM zaproponuje)" />
                            <ComboBox ItemsSource="{Binding ParentOptions}"
                                      SelectedItem="{Binding SelectedParentOption}"
                                      PlaceholderText="Notatka nadrzędna (opcjonalnie)"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="sdk:NoteItem">
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <sdk:SlotHost SlotId="Editor.Footer" Orientation="Vertical" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto,*">
                            <TextBox Grid.Column="0"
                                     Text="{Binding NoteText}"
                                     Classes="editor"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     PlaceholderText="Wpisz notatkę... (odwołaj się do innej przez [[Tytuł notatki]])"
                                     FontSize="15" />

                            <Border Grid.Column="1" Width="1" Background="{DynamicResource CtpSurface2}" Margin="16,0" />

                            <md:MarkdownScrollViewer Grid.Column="2" Markdown="{Binding NoteText, Converter={x:Static conv:AutoLinkConverter.Instance}}" />
                        </Grid>
                    </DockPanel>

                    <DockPanel Margin="0,20,0,0" IsVisible="{Binding IsNoteTabActive}">
                    <DockPanel IsVisible="{Binding SelectedNote, Converter={x:Static acnv:ObjectConverters.IsNotNull}}">
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedNote.Title}"
                                           FontSize="19" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="{Binding SelectedNote.Pinned, Converter={x:Static conv:PinLabelConverter.Instance}}"
                                        Classes="subtleAction" Command="{Binding TogglePinCommand}"
                                        IsEnabled="{Binding !IsEditingNote}" />
                                <Button Grid.Column="2" Content="Kopiuj" Classes="subtleAction" Click="CopyNote_Click"
                                        IsEnabled="{Binding !IsEditingNote}" />
                                <Button Grid.Column="3" Content="Edytuj" Classes="subtleAction"
                                        Command="{Binding StartEditNoteCommand}" IsVisible="{Binding !IsEditingNote}" />
                                <sdk:SlotHost Grid.Column="5" SlotId="Note.Actions" Margin="8,0,0,0" IsEnabled="{Binding !IsEditingNote}" />
                            </Grid>
                            <sdk:SlotHost SlotId="Note.Header" Orientation="Vertical" IsVisible="{Binding !IsEditingNote}" />
                        </StackPanel>

                        <sdk:SlotHost DockPanel.Dock="Bottom" SlotId="Note.Footer" Orientation="Vertical" Margin="0,12,0,0" IsVisible="{Binding !IsEditingNote}" />

                        <Panel>
                            <DockPanel IsVisible="{Binding IsEditingNote}">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                    <Button Content="Zapisz zmiany" Classes="accent" Command="{Binding SaveNoteEditCommand}" />
                                    <Button Content="Anuluj" Classes="subtleAction" Command="{Binding CancelEditNoteCommand}" />
                                    <TextBlock Text="{Binding NoteEditStatus}" Classes="subtle" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto,*">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding EditNoteText}"
                                             Classes="editor"
                                             AcceptsReturn="True" TextWrapping="Wrap" />

                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource CtpSurface2}" Margin="16,0" />

                                    <md:MarkdownScrollViewer Grid.Column="2" Markdown="{Binding EditNoteText, Converter={x:Static conv:AutoLinkConverter.Instance}}" SelectionEnabled="True" />
                                </Grid>
                            </DockPanel>

                            <md:MarkdownScrollViewer Markdown="{Binding SelectedNote.RawContent, Converter={x:Static conv:AutoLinkConverter.Instance}}" SelectionEnabled="True" IsVisible="{Binding !IsEditingNote}" />
                        </Panel>
                    </DockPanel>
                    </DockPanel>


                    <Grid ColumnDefinitions="220,*" Margin="0,20,0,0" IsVisible="{Binding IsAgentTabActive}">

                        <DockPanel Grid.Column="0">
                            <Button DockPanel.Dock="Top" Content="Nowa rozmowa" Classes="accent"
                                    Command="{Binding NewAgentSessionCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                            <ListBox ItemsSource="{Binding AgentSessions}" SelectedItem="{Binding SelectedAgentSession}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="✕" Classes="subtleAction"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteAgentSessionCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <DockPanel Grid.Column="1" Margin="20,0,0,0">
                            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,14,0,0">
                                <Border Classes="chatAgent" IsVisible="{Binding AgentPending, Converter={x:Static acnv:ObjectConverters.IsNotNull}}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding AgentPending.Summary}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Tak" Classes="accent"
                                                    Command="{Binding AcceptAgentActionCommand}" />
                                            <Button Content="Nie" Classes="danger"
                                                    Command="{Binding RejectAgentActionCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="AgentInputBox" Grid.Column="0" Text="{Binding AgentInputText}"
                                             PlaceholderText="Napisz do agenta... (@ dla notatek/folderow)"
                                             IsEnabled="{Binding !IsAgentBusy}" Margin="0,0,8,0"
                                             TextChanged="AgentInput_TextChanged" KeyDown="AgentInput_KeyDown" />
                                    <Popup x:Name="MentionPopup" IsOpen="{Binding ShowMentionSuggestions}"
                                           IsLightDismissEnabled="False" Placement="Bottom">
                                        <Border Classes="chatAgent" Padding="4" MaxWidth="260" MaxHeight="180">
                                            <ListBox ItemsSource="{Binding MentionSuggestions}"
                                                     SelectedIndex="{Binding MentionSuggestionIndex, Mode=OneWay}"
                                                     PointerPressed="MentionList_PointerPressed">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Padding="4,2" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                    <Button Grid.Column="1" Content="Wyślij" Classes="accent"
                                            Command="{Binding SendAgentMessageCommand}"
                                            IsEnabled="{Binding !IsAgentBusy}" />
                                </Grid>
                            </StackPanel>

                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding AgentMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes.chatUser="{Binding IsUser}" Classes.chatAgent="{Binding !IsUser}"
                                                    Margin="0,0,0,8" MaxWidth="520">
                                                <md:MarkdownScrollViewer Markdown="{Binding Text}" SelectionEnabled="True" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                </Panel>
            </DockPanel>
        </Border>

    </Grid>

</Window>
